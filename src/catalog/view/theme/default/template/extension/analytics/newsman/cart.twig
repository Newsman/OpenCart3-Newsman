<script{{ tag_attrib }}>
    _nzm.run('require', 'ec');

    var ajaxurl = '{{ base_url }}/index.php?route=extension/module/newsman/cart';
    var isProd = true;
    // Durable cart fingerprint storage.
    //
    // Until 3.1.11 the last reported cart was kept in per-tab sessionStorage,
    // which the browser drops when the tab closes. On the visitor's next visit
    // the script found no fingerprint, considered the (unchanged) cart to be
    // new and re-sent clear_cart + add to cart; Newsman saw a brand new cart
    // and restarted the abandoned cart automation, so the same visitor received
    // the same email after every return to the site.
    //
    // localStorage keeps the fingerprint across sessions and tabs; per-tab
    // storage and an in-memory value remain as fallbacks when localStorage is
    // unavailable (private mode, blocked). The server keeps its own fingerprint
    // in the OpenCart session (see the /cart endpoint), so the cart is
    // re-reported only when BOTH sides lost track of it.
    var nzmCartStore = (function () {
        var key = 'nzm_last_cart';
        var memory = null;
        var store = null;
        try {
            if (window.localStorage) {
                window.localStorage.setItem('nzm_test', '1');
                window.localStorage.removeItem('nzm_test');
                store = window.localStorage;
                // One-time migration of the pre-3.1.12 per-tab fingerprint, so
                // an already-tracked tab does not re-report on upgrade.
                try {
                    if (store.getItem(key) === null && window.sessionStorage) {
                        var legacy = window.sessionStorage.getItem('lastCart');
                        if (legacy !== null) {
                            store.setItem(key, legacy);
                        }
                    }
                } catch (e) {}
            }
        } catch (e) {}
        if (!store) {
            try {
                if (window.sessionStorage) {
                    store = window.sessionStorage;
                }
            } catch (e) {}
        }

        return {
            get: function () {
                if (!store) {
                    return memory;
                }
                try {
                    return store.getItem(key);
                } catch (e) {
                    return memory;
                }
            },
            set: function (value) {
                memory = value;
                if (!store) {
                    return;
                }
                try {
                    store.setItem(key, value);
                } catch (e) {}
            }
        };
    })();

    let lastCart = nzmCartStore.get();
    if (lastCart === null) {
        lastCart = {};
    }
    var lastCartFlag = false;
    var firstLoad = true;
    var bufferedXHR = false;
    var unlockClearCart = true;
    var isError = false;
    let secondsAllow = 5;
    let msRunAutoEvents = 5000;
    let msClick = new Date();
    var documentComparer = document.location.hostname;
    var documentUrl = document.URL;
    var sameOrigin = (documentUrl.indexOf(documentComparer) !== -1);
    let startTime, endTime;

    function startTimePassed() {
        startTime = new Date();
    }

    startTimePassed();

    function endTimePassed() {
        var flag = false;
        endTime = new Date();
        var timeDiff = endTime - startTime;
        timeDiff /= 1000;
        var seconds = Math.round(timeDiff);
        if (firstLoad) {
            flag = true;
        }
        if (seconds >= secondsAllow) {
            flag = true;
        }

        return flag;
    }

    if (sameOrigin) {
        NewsmanAutoEvents();
        setInterval(NewsmanAutoEvents, msRunAutoEvents);
        detectClicks();
        detectXHR();
        detectFetch();
    }

    function timestampGenerator(min, max) {
        min = Math.ceil(min);
        max = Math.floor(max);
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // Confirm to the server that the current cart state was reported to
    // Newsman, so the session-side fingerprint stays in sync with the
    // localStorage one. Fire-and-forget.
    function nzmConfirmReported(hash) {
        if (!hash) {
            return;
        }
        try {
            var xhrConfirm = new XMLHttpRequest();
            xhrConfirm.open('POST', ajaxurl, true);
            xhrConfirm.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhrConfirm.send('reported_hash=' + encodeURIComponent(hash));
        } catch (e) {}
    }

    function NewsmanAutoEvents() {
        if (!endTimePassed()) {
            if (!isProd) {
                console.log('newsman remarketing: execution stopped at the beginning, ' + secondsAllow + ' seconds did not pass between requests');
            }
            return;
        }
        if (isError && isProd === true) {
            console.log('newsman remarketing: an error occurred, set isProd = false in console, script execution stopped;');
            return;
        }
        let xhr = new XMLHttpRequest()
        if (bufferedXHR || firstLoad) {
            var paramChar = '?v=2&t=';
            if (ajaxurl.indexOf('?') >= 0) {
                paramChar = '&v=2&t=';
            }
            var timestamp = paramChar + Date.now() + timestampGenerator(999, 999999999);
            try {
                xhr.open('GET', ajaxurl + timestamp, true);
            } catch (ex) {
                if (!isProd) {
                    console.log('newsman remarketing: malformed XHR url');
                }
                isError = true;
            }
            startTimePassed();
            xhr.onload = function () {
                if (xhr.status == 200 || xhr.status == 201) {
                    try {
                        var payload = JSON.parse(xhr.responseText);
                    } catch (error) {
                        if (!isProd) {
                            console.log('newsman remarketing: error occured json parsing response');
                        }
                        isError = true;
                        return;
                    }
                    var response;
                    var serverHash = '';
                    var serverReported = false;
                    if (Object.prototype.toString.call(payload) === '[object Array]') {
                        // Legacy shape (server without v=2 support).
                        response = payload;
                    } else {
                        response = payload.items || [];
                        serverHash = payload.hash || '';
                        serverReported = !!payload.reported;
                    }
                    lastCart = JSON.parse(nzmCartStore.get());
                    if (lastCart === null) {
                        lastCart = {};
                        if (!isProd) {
                            console.log('newsman remarketing: lastCart === null');
                        }
                    }
                    //check cache
                    if ((typeof lastCart !== 'undefined') && lastCart.length > 0 && (typeof response !== 'undefined') && response.length > 0) {
                        var objComparer = response;
                        var missingProp = false;
                        lastCart.forEach(e => {
                            if (!e.hasOwnProperty('name')) {
                                missingProp = true;
                            }
                        });
                        if (missingProp) {
                            objComparer.forEach(function (v) {
                                delete v.name
                            });
                        }
                        if (JSON.stringify(lastCart) === JSON.stringify(objComparer)) {
                            if (!isProd) {
                                console.log('newsman remarketing: cache loaded, cart is unchanged');
                            }
                            lastCartFlag = true;
                        } else {
                            lastCartFlag = false;
                            if (!isProd) {
                                console.log('newsman remarketing: cache loaded, cart is changed');
                            }
                        }
                    }
                    if (response.length > 0 && lastCartFlag == false) {
                        if (serverReported) {
                            // The server session already reported this exact cart
                            // (the local fingerprint was lost, e.g. cleared
                            // storage). Re-sync the local fingerprint without
                            // re-sending, so the abandoned cart automation is
                            // not restarted.
                            nzmCartStore.set(JSON.stringify(response));
                            if (!isProd) {
                                console.log('newsman remarketing: cart already reported in this session, local fingerprint synced');
                            }
                        } else {
                            nzmAddToCart(response, serverHash);
                        }
                    } else if (response.length == 0 && lastCart.length > 0 && unlockClearCart) {
                        if (serverReported) {
                            // The empty cart was already reported in this session;
                            // only re-sync the local fingerprint.
                            nzmCartStore.set(JSON.stringify([]));
                            if (!isProd) {
                                console.log('newsman remarketing: empty cart already reported in this session, local fingerprint synced');
                            }
                        } else {
                            //send only when on last request, products existed
                            nzmClearCart(serverHash);
                            if (!isProd) {
                                console.log('newsman remarketing: clear cart sent');
                            }
                        }
                    } else {
                        if (lastCartFlag && serverHash && !serverReported) {
                            // The local fingerprint says the cart was reported,
                            // the session does not know it yet (e.g. new
                            // session, same browser). Sync the session so both
                            // guards agree.
                            nzmConfirmReported(serverHash);
                        }
                        if (!isProd) {
                            console.log('newsman remarketing: request not sent');
                        }
                    }
                    firstLoad = false;
                    bufferedXHR = false;
                } else {
                    if (!isProd) {
                        console.log('newsman remarketing: response http status code is not 200');
                    }
                    isError = true;
                }
            }
            try {
                xhr.send(null);
            } catch (ex) {
                if (!isProd) {
                    console.log('newsman remarketing: error on xhr send');
                }
                isError = true;
            }
        } else {
            if (!isProd) {
                console.log('newsman remarketing: !buffered xhr || first load');
            }
        }
    }

    function nzmClearCart(serverHash) {
        _nzm.run('ec:setAction', 'clear_cart');
        _nzm.run('send', 'event', 'detail view', 'click', 'clearCart');
        nzmCartStore.set(JSON.stringify([]));
        nzmConfirmReported(serverHash);
        unlockClearCart = false;
    }

    function nzmAddToCart(response, serverHash) {
        _nzm.run('ec:setAction', 'clear_cart');
        if (!isProd) {
            console.log('newsman remarketing: clear cart sent, add to cart function');
        }
        detailviewEvent(response, serverHash);
    }

    function detailviewEvent(response, serverHash) {
        if (!isProd) {
            console.log('newsman remarketing: detailviewEvent execute');
        }
        _nzm.run('send', 'event', 'detail view', 'click', 'clearCart', null, function () {
            if (!isProd) {
                console.log('newsman remarketing: executing add to cart callback');
            }
            var products = [];
            for (var item in response) {
                if (response[item].hasOwnProperty('id')) {
                    // Pass a fresh copy to _nzm — Newsman's send pipeline mutates
                    // queued product objects, which would otherwise strip "name"
                    // from the entry we persist in the cart fingerprint store.
                    _nzm.run('ec:addProduct', {
                        id: response[item].id,
                        name: response[item].name,
                        price: response[item].price,
                        quantity: response[item].quantity
                    });
                    products.push({
                        id: response[item].id,
                        name: response[item].name,
                        price: response[item].price,
                        quantity: response[item].quantity
                    });
                }
            }
            _nzm.run('ec:setAction', 'add');
            _nzm.run('send', 'event', 'UX', 'click', 'add to cart');
            nzmCartStore.set(JSON.stringify(products));
            nzmConfirmReported(serverHash);
            unlockClearCart = true;
            if (!isProd) {
                console.log('newsman remarketing: cart sent');
            }
        });
    }

    function detectClicks() {
        window.addEventListener('click', function () {
            msClick = new Date();
        }, false);
    }

    function detectXHR() {
        var proxied = window.XMLHttpRequest.prototype.send;
        window.XMLHttpRequest.prototype.send = function () {
            var pointer = this;
            var validate = false;
            var timeValidate = false;
            var intervalId = window.setInterval(function () {
                if (pointer.readyState != 4) {
                    return;
                }
                var msClickPassed = new Date();
                var timeDiff = msClickPassed.getTime() - msClick.getTime();
                if (timeDiff > {{ nzm_time_diff }}) {
                    validate = false;
                } else {
                    timeValidate = true;
                }
                var _location = pointer.responseURL;
                //own request exclusion
                if (timeValidate) {
                    if (_location.indexOf('extension/module/newsman/cart') >= 0) {
                        validate = false;
                    } else {
                        if (_location.indexOf(window.location.origin) !== -1) {
                            validate = true;
                        }
                    }
                    if (validate) {
                        bufferedXHR = true;
                        if (!isProd) {
                            console.log('newsman remarketing: ajax request fired and caught from same domain, NewsmanAutoEvents called');
                        }
                        NewsmanAutoEvents();
                    }
                }
                clearInterval(intervalId);
            }, 1);
            return proxied.apply(this, [].slice.call(arguments));
        }
    }

    function detectFetch() {
        if (typeof window.fetch !== 'function') {
            return;
        }
        var origFetch = window.fetch;

        window.fetch = function () {
            var reqUrl = '';
            try {
                var a0 = arguments[0];
                reqUrl = typeof a0 === 'string' ? a0 : (a0 && a0.url) || '';
            } catch (e) {}

            var promise = origFetch.apply(this, arguments);

            promise.then(function (response) {
                var validate = false;
                var timeValidate = false;

                var msClickPassed = new Date();
                var timeDiff = msClickPassed.getTime() - msClick.getTime();
                if (timeDiff > {{ nzm_time_diff }}) {
                    validate = false;
                } else {
                    timeValidate = true;
                }

                var _location = (response && response.url) || reqUrl;

                if (timeValidate) {
                    if (_location.indexOf('extension/module/newsman/cart') >= 0) {
                        validate = false;
                    } else {
                        if (_location.indexOf(window.location.origin) !== -1) {
                            validate = true;
                        }
                    }

                    if (validate) {
                        bufferedXHR = true;
                        if (!isProd) {
                            console.log('newsman remarketing: fetch fired and caught from same domain, NewsmanAutoEvents called');
                        }
                        NewsmanAutoEvents();
                    }
                }
            }).catch(function () {});

            return promise;
        };
    }
</script>
